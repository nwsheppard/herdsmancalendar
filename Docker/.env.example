# Copy this file to Docker/.env (same folder, gitignored -- see Docker/README.md)
# and fill in your own FlareSolverr instance's address. docker-compose.yml
# reads .env automatically from this same directory.
#
# FlareSolverr: https://github.com/FlareSolverr/FlareSolverr -- a small
# self-hosted proxy that solves Cloudflare's JS challenge (which Forex
# Factory now sits behind) with a real headless browser, so calendar_api.py
# itself doesn't need to bundle one. Run it as its own container/service
# somewhere on your network, then point this at it.
FLARESOLVERR_URL=http://192.168.1.50:8191
